# Telegram Bot Token from @BotFather
FIT_BOT_TOKEN=

# Google Spreadsheet ID (from URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit)
FIT_SPREADSHEET_ID=

# Optional: restrict bot to specific chat (group/supergroup ID)
FIT_CHAT_ID=

# Optional: restrict bot to specific thread (forum topic ID)
FIT_THREAD_ID=
